const APP = { NAME: 'Portale Vibe Coding', TZ: 'Europe/Rome', SHEET_NAME: 'VIBE CODING — REGISTRO', ROOT_FOLDER: 'Vibe Coding — Materiali e Consegne', MAX_FILE_BYTES: 8 * 1024 * 1024 };
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle(APP.NAME).addMetaTag('viewport','width=device-width, initial-scale=1');}
function setupVibeCoding(){
 const props=PropertiesService.getScriptProperties(),ss=getOrCreateSpreadsheet_();props.setProperty('VIBE_SPREADSHEET_ID',ss.getId());
 const defs={UTENTI:['email','ruolo','attivo'],LEZIONI:['numero','titolo','descrizione','pubblicata','aggiornataIl','aggiornataDa'],MATERIALI:['id','lezione','titolo','nomeFile','mimeType','fileId','descrizione','caricatoIl','caricatoDa','attivo'],CONSEGNE:['id','timestamp','emailCorsista','nomeFile','mimeType','fileId','urlDrive','lezione','nota','stato']};
 Object.keys(defs).forEach(n=>{let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);if(sh.getLastRow()===0)sh.getRange(1,1,1,defs[n].length).setValues([defs[n]]);sh.setFrozenRows(1);});
 const root=getOrCreateFolder_(APP.ROOT_FOLDER);getOrCreateChildFolder_(root,'Materiali');getOrCreateChildFolder_(root,'Consegne');
 const sh=ss.getSheetByName('LEZIONI');if(sh.getLastRow()<2)sh.getRange(2,1,6,6).setValues([[1,'Dal linguaggio naturale al software','Fondamenti di vibe coding e prima applicazione didattica',false,'',''],[2,'Progettare applicazioni interattive','Esigenza didattica, requisiti e interazione',false,'',''],[3,'Logica, simulazioni e laboratori virtuali','Modelli, dati e simulazioni disciplinari',false,'',''],[4,'Debugging, privacy e accessibilità','Test, qualità e pubblicazione consapevole',false,'',''],[5,'Project work','Realizzazione guidata di un’applicazione',false,'',''],[6,'Validazione e presentazione','Collaudo, revisione e piano di sperimentazione',false,'','']]);
 return {ok:true,spreadsheetUrl:ss.getUrl(),driveFolderUrl:root.getUrl()};
}
function getOrCreateSpreadsheet_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('VIBE_SPREADSHEET_ID');if(id){try{return SpreadsheetApp.openById(id)}catch(e){}}const ss=SpreadsheetApp.create(APP.SHEET_NAME);p.setProperty('VIBE_SPREADSHEET_ID',ss.getId());return ss;}
function db_(){const id=PropertiesService.getScriptProperties().getProperty('VIBE_SPREADSHEET_ID');if(!id)throw new Error('Database non inizializzato: esegui setupVibeCoding().');return SpreadsheetApp.openById(id);}
function getOrCreateFolder_(n){const it=DriveApp.getFoldersByName(n);return it.hasNext()?it.next():DriveApp.createFolder(n);}
function getOrCreateChildFolder_(p,n){const it=p.getFoldersByName(n);return it.hasNext()?it.next():p.createFolder(n);}
function verifyIdentity(idToken){
 if(!idToken)throw new Error('Accedi con Google per continuare.');const props=PropertiesService.getScriptProperties(),clientId=props.getProperty('GOOGLE_CLIENT_ID');if(!clientId)throw new Error('Manca GOOGLE_CLIENT_ID nelle Proprietà script.');
 const res=UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token='+encodeURIComponent(idToken),{muteHttpExceptions:true});if(res.getResponseCode()!==200)throw new Error('Accesso Google non valido o scaduto.');
 const c=JSON.parse(res.getContentText());if(c.aud!==clientId||String(c.email_verified)!=='true')throw new Error('Identità Google non verificata.');const email=String(c.email||'').trim().toLowerCase(),teachers=csv_(props.getProperty('TEACHER_EMAILS')),students=csv_(props.getProperty('STUDENT_EMAILS'));let role='';
 if(teachers.includes(email))role='DOCENTE';else if(students.length===0||students.includes(email))role='CORSISTA';if(!role)throw new Error('Account Google non autorizzato al portale.');upsertUser_(email,role);return {email,role};
}
function csv_(s){return String(s||'').split(/[;,\n]/).map(x=>x.trim().toLowerCase()).filter(Boolean);}
function upsertUser_(email,role){const sh=db_().getSheetByName('UTENTI'),rows=sh.getDataRange().getValues();for(let i=1;i<rows.length;i++)if(String(rows[i][0]).toLowerCase()===email){sh.getRange(i+1,2,1,2).setValues([[role,true]]);return;}sh.appendRow([email,role,true]);}
function requireUser_(token){const u=verifyIdentity(token),rows=db_().getSheetByName('UTENTI').getDataRange().getValues(),r=rows.slice(1).find(x=>String(x[0]).toLowerCase()===u.email);if(!r||r[2]!==true)throw new Error('Account disabilitato.');return u;}
function getPortalData(token){const u=requireUser_(token),ss=db_(),lessons=ss.getSheetByName('LEZIONI').getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({number:Number(r[0]),title:String(r[1]||''),description:String(r[2]||''),published:r[3]===true})),current=lessons.filter(x=>x.published).sort((a,b)=>b.number-a.number)[0]||null,visible=u.role==='DOCENTE'?lessons:(current?[current]:[]),materials=ss.getSheetByName('MATERIALI').getDataRange().getValues().slice(1).filter(r=>r[0]&&r[9]===true&&(u.role==='DOCENTE'||(current&&Number(r[1])===current.number))).map(r=>({id:r[0],lesson:Number(r[1]),title:r[2],fileName:r[3],mimeType:r[4],fileId:r[5],description:r[6]}));return {user:u,lessons:visible,currentLesson:current,materials};}
function publishLesson(token,num){const u=requireUser_(token);if(u.role!=='DOCENTE')throw new Error('Operazione riservata al docente.');num=Number(num);if(!Number.isInteger(num)||num<1||num>6)throw new Error('Numero lezione non valido.');const sh=db_().getSheetByName('LEZIONI'),rows=sh.getDataRange().getValues();let found=false;for(let i=1;i<rows.length;i++){if(Number(rows[i][0])===num){sh.getRange(i+1,4,1,3).setValues([[true,new Date(),u.email]]);found=true;}else sh.getRange(i+1,4).setValue(false);}if(!found)throw new Error('Lezione non trovata.');return {ok:true,published:num};}
function saveFile_(token,payload,kind){const u=requireUser_(token);if(!payload||!payload.base64||!payload.fileName)throw new Error('File mancante.');const bytes=Utilities.base64Decode(payload.base64);if(bytes.length>APP.MAX_FILE_BYTES)throw new Error('Il file supera il limite di 8 MB.');const lesson=Number(payload.lesson);if(!Number.isInteger(lesson)||lesson<1||lesson>6)throw new Error('Lezione non valida.');if(kind==='MATERIALE'&&u.role!=='DOCENTE')throw new Error('Solo il docente può caricare materiali.');if(kind==='CONSEGNA'&&u.role!=='CORSISTA')throw new Error('Solo i corsisti possono inviare consegne.');const ss=db_(),root=getOrCreateFolder_(APP.ROOT_FOLDER),folder=getOrCreateChildFolder_(root,kind==='MATERIALE'?'Materiali':'Consegne'),name=String(payload.fileName).replace(/[\\/:*?"<>|#%]/g,'_').slice(0,180),mime=String(payload.mimeType||'application/octet-stream').slice(0,120),file=folder.createFile(Utilities.newBlob(bytes,mime,name)),id=Utilities.getUuid();if(kind==='MATERIALE')ss.getSheetByName('MATERIALI').appendRow([id,lesson,String(payload.description||'').slice(0,1000),name,mime,file.getId(),String(payload.description||'').slice(0,1000),new Date(),u.email,true]);else ss.getSheetByName('CONSEGNE').appendRow([id,new Date(),u.email,name,mime,file.getId(),file.getUrl(),lesson,String(payload.note||'').slice(0,2000),'RICEVUTA']);return {ok:true,fileName:name,lesson};}
function uploadMaterial(token,payload){return saveFile_(token,payload,'MATERIALE');}
function submitAssignment(token,payload){return saveFile_(token,payload,'CONSEGNA');}
